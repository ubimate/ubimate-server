{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src"],
  // Tests are not part of the shipped build (and relayIntegration.test.ts
  // imports the client provider from apps/web, outside rootDir). They are
  // typechecked by src/__tests__/tsconfig.json instead.
  "exclude": ["node_modules", "dist", "src/__tests__"]
}
