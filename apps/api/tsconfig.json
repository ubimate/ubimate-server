{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    /**
     * Dead code is a type error, as it already is in `apps/web`. See
     * `packages/notion-import/tsconfig.json` for how the gap was found: an unused import survived a
     * package's own `pnpm typecheck` and was caught only because `apps/web` compiles that package
     * from source. Every package was probed afterwards and four more missed it; none had a
     * violation, so the flags cost nothing and close the hole.
     */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src"],
  // Tests are not part of the shipped build (and relayIntegration.test.ts
  // imports the client provider from apps/web, outside rootDir). They are
  // typechecked by src/__tests__/tsconfig.json instead.
  "exclude": ["node_modules", "dist", "src/__tests__"]
}
